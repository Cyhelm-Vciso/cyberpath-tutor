# PUBLIC SITE DEFAULT: leave this blank. The public deployment intentionally
# disables built-in OpenAI text, Realtime voice, and managed transcription.
#
# Self-hosted deployments may set a server-side OpenAI project API key here for
# local development, or as a secret in the production hosting environment.
# Never prefix this variable with EXPO_PUBLIC_ or commit .env.local.
OPENAI_API_KEY=

# Public deployments can disable every managed OpenAI path in both layers:
# - EXPO_PUBLIC_PUBLIC_DEMO is embedded into the client during the Expo build.
# - CYBERPATH_PUBLIC_DEMO blocks the hosted /api routes at runtime, even if a
#   server key is accidentally configured later.
# Keep both false for a private/self-hosted deployment that should offer the
# built-in OpenAI provider.
EXPO_PUBLIC_PUBLIC_DEMO=false
CYBERPATH_PUBLIC_DEMO=false

# Optional built-in text-tutor override. When unset, the server currently uses
# gpt-5.6-luna.
# OPENAI_MODEL=gpt-5.6-luna

# Optional OpenAI voice overrides. These values are checked against server
# allowlists. The current Realtime route accepts only the values shown below.
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Provider Voice Turns use this separate OpenAI transcription model. When unset,
# the server uses gpt-4o-transcribe. Uncomment the mini model to prefer its
# different cost/quality profile.
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional origin for a separately hosted Expo API server.
# - Leave blank for the web app and normal Expo development; the development
#   server is discovered automatically.
# - Production native builds require an HTTPS origin.
# - Development builds may use a reachable HTTP LAN origin, for example:
#   http://192.168.1.20:8081
# Use an origin only: no credentials, query, fragment, or /api endpoint path.
EXPO_PUBLIC_API_URL=

# Local and custom LLM URLs are configured per device inside
# Profile -> AI provider. They are intentionally not environment variables.
