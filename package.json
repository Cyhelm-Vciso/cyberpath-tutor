    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-server": "~57.0.1",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "openai": "^6.48.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "pngjs": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "build": "expo export --platform web --clear",
    "build:site": "npm run build && node ./scripts/build-site.mjs",
    "build:public": "node ./scripts/build-public-site.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "npm run test:unit && npm run build:site && npm run test:site",
    "test:unit": "npm run test:provider && npm run test:public-demo && npm run test:avatar && npm run test:local-voice && npm run test:voice-layout && npm run test:realtime && npm run test:voice",
    "test:provider": "node --test tests/provider-catalog.test.mjs",
    "test:public-demo": "node --test tests/public-demo-provider.test.mjs",
    "test:avatar": "node --test tests/avatar-lip-sync.test.mjs",
    "test:local-voice": "node --test tests/local-live-voice.test.mjs",
    "test:voice-layout": "node --test tests/voice-tutor-layout.test.mjs",
    "test:realtime": "node --test tests/realtime-provider-turn.test.mjs",
    "test:site": "node --test tests/site-worker.test.mjs",
    "test:voice": "node --test tests/voice-mode.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "private": true
}
